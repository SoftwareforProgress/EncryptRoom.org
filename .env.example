# EncryptRoom API base URL
# Defaults to https://api.encryptroom.org when unset.
NEXT_PUBLIC_ENCRYPTROOM_API_URL=https://api.encryptroom.org

# EncryptRoom relay URL used for bundle creation
# Defaults to tls://relay1.encryptroom.org:443 when unset.
NEXT_PUBLIC_ENCRYPTROOM_RELAY_URL=tls://relay1.encryptroom.org:443
